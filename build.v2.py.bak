def room_card(r, reveal):
    detail = ('<a href="%s" target="_blank" rel="noopener">Full details</a>' % r["url"]) if r["url"] else ""
    return """
      <article class="rcard tilt" id="{id}" data-type="{type}" data-reveal="{reveal}">
        <div class="rcard__media">
          <img src="{img}" alt="{name} at Sambodhi Retreat" loading="lazy" decoding="async">
          <span class="rcard__veil"></span>
          <div class="rcard__over">
            <h3 class="rcard__name">{name}</h3>
            <ul class="rcard__specs"><li>{guests}</li><li>{bed}</li></ul>
          </div>
        </div>
        <div class="rcard__body">
          <p class="rcard__desc">{desc}</p>
          <div class="rcard__foot">
            <p class="rcard__price"><b>{price}</b><span>from / night</span></p>
            <div class="rcard__links">{detail}
              <a href="{book}" target="_blank" rel="noopener">Book now</a>
            </div>
          </div>
        </div>
      </article>""".format(detail=detail, book=BOOK, reveal=reveal, **r)


