         hero=IMG + "Homepage_Resort_INDEX/top-slider-img10.jpg",
         crumb="Gallery", eyebrow="Gallery",
         h1="Take a look around.",
         lede="Cottages, restaurant, reception and the natural attractions next door.",
         cta=IMG + "gallery/14.jpg", body=gallery_body()),

    dict(file="blog.html",
         title="Blog &mdash; Sambodhi Retreat, Bodhgaya",
         desc="Stories from Sambodhi Retreat: weddings in Bodhgaya, organic food, places to visit, and what to expect from a luxury stay in Bihar.",
         hero=IMG + "Gallery/Top-5-Places-in-Bodh-Gaya.jpg",
         crumb="Blog", eyebrow="Journal",
         h1="Stories from Sambodhi.",
         lede="Weddings, food, the city around us, and the things guests ask before they arrive.",
         cta=IMG + "gallery/24.jpg", body=blog_body()),

    dict(file="contact.html",
         title="Contact &mdash; Sambodhi Retreat, Bodhgaya",
         desc="Contact Sambodhi Retreat, Hathiyar, Bodhgaya, Gaya, Bihar 824231. About 16.4 km from Gaya Junction and 15.0 km from Gaya Airport.",
         hero=IMG + "Homepage_Resort_INDEX/top-slider-img5.jpg",
         crumb="Contact", eyebrow="Contact",
         h1="Begin your journey.",
         lede="Hathiyar, Bodhgaya &mdash; about 40 minutes from Gaya Junction.",
         cta=IMG + "Homepage_Resort_INDEX/top-slider-img8.jpg", body=contact_body()),
]


def build():
    for p in PAGES:
        body = p["body"] + CLOSING_CTA.replace("{{CTAIMG}}", p["cta"])
        html = (SHELL
                .replace("{{TITLE}}",     p["title"])
                .replace("{{DESC}}",      p["desc"])
                .replace("{{FOOTNAV}}",   nav_html(p["file"], "nav"))
                .replace("{{DRAWERNAV}}", nav_html(p["file"], "drawer"))
                .replace("{{HEROIMG}}",   p["hero"])
                .replace("{{CRUMB}}",     p["crumb"])
                .replace("{{EYEBROW}}",   p["eyebrow"])
                .replace("{{H1}}",        p["h1"])
                .replace("{{HEROLEDE}}",  p["lede"])
                .replace("{{BODY}}",      body)
                .replace("{{BOOK}}",      BOOK))
        (OUT / p["file"]).write_text(html, encoding="utf-8")
        print("wrote", p["file"], len(html), "bytes")


if __name__ == "__main__":
    build()
